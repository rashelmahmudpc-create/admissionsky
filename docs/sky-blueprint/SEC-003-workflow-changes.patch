diff --git a/guard-health-triggers.test.mjs b/guard-health-triggers.test.mjs
new file mode 100644
index 0000000..faee52c
--- /dev/null
+++ b/guard-health-triggers.test.mjs
@@ -0,0 +1,69 @@
+/* A1.5 ③ (owner order 2026-10-29) promised a guard health check every 15
+ * minutes. GitHub throttles that cron — the live history showed 2 runs in a day
+ * — so a red guard could sit unannounced for hours. The fix is an event trigger,
+ * and an event trigger is exactly the kind of config that fails SILENTLY: a name
+ * that does not match a workflow means the workflow_run event never fires and
+ * nothing anywhere says so. These tests compare the three lists that must agree
+ * — the GUARDS the job watches, the workflow names that exist, and the
+ * workflow_run filter — so a rename cannot quietly unhook the alert. */
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync, readdirSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = new URL('./.github/workflows/', import.meta.url);
+const HEALTH = readFileSync(new URL('guard-health.yml', ROOT), 'utf8');
+
+function workflowName(file) {
+  const src = readFileSync(new URL(file, ROOT), 'utf8');
+  const match = src.match(/^name:\s*(.+)$/m);
+  if (!match) return '';
+  return match[1].replace(/\s+#.*$/, '').trim().replace(/^['"]|['"]$/g, '');
+}
+
+const WORKFLOW_NAMES = readdirSync(fileURLToPath(ROOT))
+  .filter((file) => file.endsWith('.yml') || file.endsWith('.yaml'))
+  .map(workflowName)
+  .filter(Boolean);
+
+function guardsWatched() {
+  const start = HEALTH.indexOf('const GUARDS = [');
+  assert.ok(start > 0, 'the job no longer declares GUARDS');
+  const end = HEALTH.indexOf('];', start);
+  return [...HEALTH.slice(start, end).matchAll(/'([^']+)'/g)].map((m) => m[1]);
+}
+
+function workflowRunNames() {
+  const start = HEALTH.indexOf('workflow_run:');
+  assert.ok(start > 0, 'guard-health.yml must declare a workflow_run trigger');
+  const end = HEALTH.indexOf('workflow_dispatch:', start);
+  const block = HEALTH.slice(start, end === -1 ? undefined : end);
+  return [...block.matchAll(/^\s{6}- (.+)$/gm)].map((m) => m[1].trim().replace(/^['"]|['"]$/g, ''));
+}
+
+test('A1.5-৩a: every guard the job watches is a real workflow', () => {
+  const guards = guardsWatched();
+  assert.ok(guards.length >= 8, `expected the full guard list, got ${guards.length}`);
+  for (const guard of guards) {
+    assert.ok(
+      WORKFLOW_NAMES.includes(guard),
+      `"${guard}" is watched by guard-health but no workflow is named that — the check would report it as never run`,
+    );
+  }
+});
+
+test('A1.5-৩b: a completed guard run triggers the check, not only the throttled cron', () => {
+  const guards = guardsWatched();
+  const triggers = workflowRunNames();
+  for (const guard of guards) {
+    assert.ok(
+      triggers.includes(guard),
+      `"${guard}" has no workflow_run trigger, so a red run of it waits for the next delivered cron`,
+    );
+  }
+});
+
+test('A1.5-৩c: the cron stays as the safety net for a missed delivery', () => {
+  assert.match(HEALTH, /cron:\s*'\*\/15 \* \* \* \*'/);
+  assert.match(HEALTH, /types:\s*\[completed\]/, 'workflow_run must fire on completion, not on every phase');
+});
